cflags = -Wall -Wextra -g -O2 -std=c99
ldlibs = -lraylib -lm -lminiupnpc

rule cc
    command = cc $cflags $in -o $out $ldlibs
    description = CC $out

rule cc_debug
    command = cc -Wall -Wextra -g -O0 -std=c99 -DDEBUG $in -o $out $ldlibs
    description = CC-debug $out

rule clean
    command = rm -f $out
    description = CLEAN $out

build nga_strike: cc main.c game.c player.c weapon.c enemy.c pickup.c audio.c world.c ui.c fx.c damage_fx.c shadows.c settings.c net.c upnp.c
build nga_strike_debug: cc_debug main.c game.c player.c weapon.c enemy.c pickup.c audio.c world.c ui.c fx.c damage_fx.c shadows.c settings.c net.c upnp.c
build clean: clean nga_strike nga_strike_debug

default nga_strike
